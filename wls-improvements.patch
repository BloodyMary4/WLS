+
+  it('голод (food=0) вредит здоровью, иначе еда убывает', () => {
+    const starving = makeCharacter({ food: 0, health: 50 });
+    expect(updateAgeStatus(starving).health).toBe(45);
+    const fed = makeCharacter({ food: 5, health: 50 });
