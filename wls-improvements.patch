+    expect(updateAgeStatus(char).status).toBe('Взрослый');
+  });
+
+  it('взрослый статус не меняется с возрастом', () => {
+    const char = makeCharacter({ age: 40, status: 'Ветеран' });
+    expect(updateAgeStatus(char).status).toBe('Ветеран');
