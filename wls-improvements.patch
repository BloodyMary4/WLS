diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 5b78646..e5556c5 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -18,4 +18,5 @@ jobs:
       - run: npm ci
       - run: npm run typecheck
       - run: npm run check
+      - run: npm run test
       - run: npm run build
diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
new file mode 100644
index 0000000..3275dd1
--- /dev/null
+++ b/.github/workflows/deploy.yml
@@ -0,0 +1,40 @@
+name: Deploy to GitHub Pages
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pages: write
+  id-token: write
+
+concurrency:
+  group: pages
+  cancel-in-progress: true
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 20
+          cache: npm
+      - run: npm ci
+      - run: npx vite build --base /WLS/
+      - uses: actions/upload-pages-artifact@v3
+        with:
+          path: dist
+
+  deploy:
+    needs: build
+    runs-on: ubuntu-latest
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - id: deployment
+        uses: actions/deploy-pages@v3
diff --git a/README.md b/README.md
index c4f13bd..7ce26d1 100644
--- a/README.md
+++ b/README.md
@@ -76,6 +76,15 @@ npm run build
 npm run check
 ```
 
+### Запуск тестов
+
+```bash
+npm test            # разовый прогон (vitest run)
+npm run test:watch  # режим наблюдения
+```
+
+Тесты покрывают ядро игровой логики: `utils` (эффекты выборов, старение), `validation`, `saveSystem`, `questSystem`, `achievements`. Настройки — в `vitest.config.ts`, фабрики объектов для тестов — в `src/game/testHelpers.ts`.
+
 ### Восстановление структуры
 
 ```bash
