+  it('null/не-объект — невалидно', () => {
+    expect(validateLegacyData(null)).toBe(false);
+    expect(validateLegacyData('string')).toBe(false);
+  });
+
+  it('отрицательные счётчики — невалидно', () => {
+    expect(validateLegacyData({ ...valid, bestAge: -1 })).toBe(false);
